# Copy to .env and fill in. Never commit .env.

# Postgres password used by both containers
DB_PASSWORD=change-this-db-password

# At least 32 random characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Platform (3S) admin, created on first start only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-password

# Create a "Demo Shipping" organisation with the Vishva Nidhi example on first start
SEED_DEMO=true

# Set to true once the app is served over HTTPS (behind nginx, Caddy, a load balancer...)
COOKIE_SECURE=false

# Port on the host
APP_PORT=3000
