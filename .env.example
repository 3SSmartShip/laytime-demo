# Copy to .env for docker-compose or local runs. Never commit .env.
# On Railway, set these as service Variables instead (see README → Deploying on Railway).

# ---------- required ----------

# Postgres password used by both docker-compose containers (not used on Railway)
DB_PASSWORD=change-this-db-password

# At least 32 random characters:  openssl rand -hex 32
# Also the key for one-time codes; changing it signs everyone out.
JWT_SECRET=

# Platform (3S) admin, created on first start only. Later changes here are ignored.
# Login IDs are 3–40 letters, digits, dot, underscore or hyphen. Avoid the default "admin".
ADMIN_LOGIN=platform.admin
ADMIN_EMAIL=
ADMIN_PASSWORD=change-this-to-a-long-password

# ---------- general ----------

# Public address, used to build invite links. Set it in production, e.g. https://laytime.example.com
APP_URL=

# Create a "Demo Shipping" organisation with the Vishva Nidhi example on first start.
# Use false in production.
SEED_DEMO=true

# true once the app is served over HTTPS. Defaults to true when NODE_ENV=production.
# Leave unset on Railway.
COOKIE_SECURE=false

# Proxy hops in front of the app: a number (1 for Railway, nginx or Caddy), or proxy IPs/subnets.
# Defaults to 1 when NODE_ENV=production.
# TRUST_PROXY=1

# How long a sign-in lasts, in hours
# SESSION_HOURS=12

# Port on the host (docker-compose only; Railway sets PORT itself)
APP_PORT=3000

# Name used in SMS and email messages
# APP_NAME=Laytime Calculator

# ---------- sign-in codes (optional) ----------
# Unset or "none" turns a channel off. "console" prints codes to the log and only works outside production.

# SMS: msg91 | twilio | webhook | none.  Email: smtp | webhook | none
OTP_SMS_PROVIDER=none
OTP_EMAIL_PROVIDER=none
# OTP_TTL_MINUTES=5
# Country code added to 10-digit mobile numbers typed without one
# DEFAULT_COUNTRY_CODE=91

# MSG91 (India: needs a DLT-registered sender and an OTP template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Name of the template variable that holds the code, if not "otp"
MSG91_CODE_VAR=

# Twilio: set TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Any other SMS gateway: the app POSTs {"to","code","message","purpose"} as JSON
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# SMTP (Google Workspace, Zoho, Amazon SES...). SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Any other email service, same JSON as the SMS webhook
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ---------- document reading (optional) ----------
# Without Luma, the built-in reader handles Excel, CSV and text.
# With Luma, uploaded documents are sent to Luma: tell clients.

LUMA_API_URL=
LUMA_API_KEY=
# LUMA_TIMEOUT_MS=120000
# Force a reader: local | luma (default: luma when LUMA_API_URL is set)
# EXTRACT_PROVIDER=
